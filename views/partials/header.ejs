<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f7f3">
  <title><%= typeof title === 'string' ? `${title} | UniFix` : 'UniFix | Campus Maintenance System' %></title>
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<header class="site-header">
  <div class="nav-shell">
    <a href="<%= user ? '/dashboard' : '/login' %>" class="brand" aria-label="UniFix home"><span class="brand-mark">UF</span><span class="brand-name">UniFix</span></a>
    <% if (user) { %>
      <nav class="main-nav"><a href="/dashboard" class="<%= !['new-request', 'profile', 'admin-analytics'].includes(currentPage) ? 'active' : '' %>">Overview</a><% if (['student', 'faculty'].includes(user.role)) { %><a href="/requests/new" class="<%= currentPage === 'new-request' ? 'active' : '' %>">UniFix Request</a><% } %><a href="/profile" class="<%= currentPage === 'profile' ? 'active' : '' %>">Profile</a><% if (user.role === 'admin') { %><a href="/admin/verifications">Admin verification</a><a href="/admin/analytics" class="<%= currentPage === 'admin-analytics' ? 'active' : '' %>">Analytics</a><% } %></nav>
      <div class="nav-user"><a class="user-avatar-link" href="/profile" aria-label="Open profile"><% if (user.profile_image) { %><img class="user-avatar" src="/profile/image" alt=""><% } else { %><span class="user-avatar"><%= user.full_name.split(' ').map((part) => part[0]).slice(0, 2).join('').toUpperCase() %></span><% } %></a><div class="user-name"><strong><%= user.full_name %></strong><small><%= user.role === 'admin' ? 'Administrator' : user.role === 'staff' ? 'Technical team' : user.role === 'faculty' ? 'Faculty' : 'Student' %></small></div><form action="/logout" method="POST"><button class="logout-button" type="submit" aria-label="Sign out" title="Sign out">↗</button></form></div>
    <% } else { %><a href="/login" class="header-signin">Sign in <span aria-hidden="true">→</span></a><% } %>
  </div>
</header>
<div class="page-content">
