<%- include('partials/header') %>
<main class="page-wrap narrow-page">
  <% if (notice) { %><div class="alert alert-<%= notice.type %>"><%= notice.message %></div><% } %>
  <a href="/dashboard" class="back-link">← <span>Back to overview</span></a>
  <section class="form-heading"><span class="eyebrow">ACCOUNT SETTINGS</span><h1>Your profile</h1><p>Review your campus account information and update your profile photo.</p></section>
  <section class="form-card profile-card">
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <div class="profile-summary">
      <% if (user.profile_image) { %><img class="profile-photo" src="/profile/image" alt="Profile photo for <%= user.full_name %>"><% } else { %><div class="profile-photo profile-photo-placeholder"><%= user.full_name.split(' ').map((part) => part[0]).slice(0, 2).join('').toUpperCase() %></div><% } %>
      <div><strong><%= user.full_name %></strong><span><%= user.role === 'staff' ? 'Technical team' : user.role === 'faculty' ? 'Faculty member' : user.role === 'admin' ? 'Administrator' : 'Student' %></span></div>
    </div>
    <dl class="profile-details">
      <div><dt>Campus ID</dt><dd><%= user.unique_id || 'Not on file' %></dd></div>
      <div><dt>Verification</dt><dd><span class="verification-status verification-<%= user.verification_status.toLowerCase() %>"><%= user.verification_status %></span></dd></div>
    </dl>
    <form action="/profile" method="POST" enctype="multipart/form-data">
      <label class="field-label" for="full_name">Full name</label>
      <input id="full_name" name="full_name" type="text" class="form-control" value="<%= values.full_name || '' %>" minlength="2" maxlength="80" autocomplete="name" required>
      <label class="field-label mt-3" for="email">Campus email</label>
      <input id="email" name="email" type="email" class="form-control" value="<%= values.email || '' %>" maxlength="254" autocomplete="email" required>
      <label class="field-label mt-3" for="profile_image">Profile photo <span class="optional-label">Optional · JPEG, PNG, or WebP · max 5 MB</span></label>
      <input id="profile_image" name="profile_image" type="file" class="form-control image-upload" accept="image/jpeg,image/png,image/webp">
      <% if (user.role === 'staff') { %>
        <fieldset class="specialty-fieldset">
          <legend class="field-label">Maintenance specialties</legend>
          <p class="profile-help">Only requests in your selected categories will appear in your queue. Update these selections any time.</p>
          <div class="category-check-grid"><% categories.forEach((category) => { %><label><input type="checkbox" name="categories" value="<%= category %>" <%= selectedCategories.includes(category) ? 'checked' : '' %>><span><%= category %></span></label><% }) %></div>
        </fieldset>
      <% } %>
      <div class="form-actions"><button type="submit" class="btn btn-primary">Save profile</button></div>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
