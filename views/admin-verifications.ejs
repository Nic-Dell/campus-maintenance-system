<%- include('partials/header') %>
<main class="page-wrap">
  <% if (notice) { %><div class="alert alert-<%= notice.type %>"><%= notice.message %></div><% } %>
  <section class="welcome-row">
    <div><span class="eyebrow">ADMINISTRATION</span><h1>Technician verification</h1><p>Review technical team accounts before they can access maintenance requests.</p></div>
    <a href="/dashboard" class="btn btn-filter">Back to overview</a>
  </section>

  <section class="requests-section">
    <div class="section-heading"><div><span class="eyebrow">MANUAL REVIEW</span><h2>Technical team accounts</h2></div><span class="result-count"><%= accounts.length %> accounts</span></div>
    <p class="verification-guidance">Students and faculty can access the system immediately after registration. Compare technician campus IDs with official records before granting maintenance access.</p>
    <% if (accounts.length) { %>
      <div class="request-list">
        <% accounts.forEach((account) => { %>
          <article class="verification-row">
            <div class="verification-account">
              <strong><%= account.full_name %></strong>
              <span><%= account.email %></span>
              <small>Technical team</small>
              <span class="verification-campus-id"><span>Campus ID</span><strong><%= account.unique_id || 'Not on file — legacy account' %></strong></span>
            </div>
            <span class="verification-status verification-<%= account.verification_status.toLowerCase() %>"><%= account.verification_status %></span>
            <form action="/admin/verifications/<%= account.id %>" method="POST" class="verification-actions">
              <button class="btn btn-filter" type="submit" name="status" value="Verifying">Mark verifying</button>
              <button class="btn btn-primary" type="submit" name="status" value="Accepted" <%= account.unique_id ? '' : 'disabled title="Cannot accept: campus ID is not on file"' %>>Accept</button>
              <button class="btn btn-reject" type="submit" name="status" value="Rejected">Reject</button>
            </form>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state"><span class="empty-illustration">✓</span><h3>No technicians to review</h3><p>New technical team registrations will appear here.</p></div>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
