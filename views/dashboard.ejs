<%- include('partials/header') %>
<main class="page-wrap">
  <% if (notice) { %><div class="alert alert-<%= notice.type %>"><%= notice.message %></div><% } %>
  <section class="welcome-row">
    <div><span class="eyebrow"><%= staffView ? 'CAMPUS OPERATIONS' : 'REQUEST STATUS' %></span><h1><%= staffView ? technicianView ? 'Technical work queue' : 'Maintenance overview' : `Hello, ${user.full_name.split(' ')[0]}.` %></h1><p><%= technicianView ? 'Accept open campus requests that match your maintenance specialties, then record work updates.' : staffView ? 'Review maintenance requests, service targets, and work updates.' : 'Review your submitted campus requests and maintenance updates.' %></p></div>
    <% if (requestCta) { %><a href="/requests/new" class="btn btn-primary request-cta"><span class="plus-mark">＋</span> Campus Request</a><% } %>
  </section>

  <section class="stats-grid" aria-label="Request summary">
    <article class="stat-card stat-total"><div class="stat-top"><span>Total requests</span><span class="stat-icon">◫</span></div><strong><%= stats.total %></strong><small><%= staffView ? 'Across campus' : 'Submitted by you' %></small></article>
    <article class="stat-card stat-open"><div class="stat-top"><span>Open</span><span class="status-dot dot-open"></span></div><strong><%= stats.open %></strong><small>Awaiting attention</small></article>
    <article class="stat-card stat-progress"><div class="stat-top"><span>In progress</span><span class="status-dot dot-progress"></span></div><strong><%= stats.inProgress %></strong><small>Being worked on</small></article>
    <article class="stat-card stat-resolved"><div class="stat-top"><span>Resolved</span><span class="status-dot dot-resolved"></span></div><strong><%= stats.resolved %></strong><small>Good as new</small></article>
  </section>

  <section class="pulse-panel">
    <div class="pulse-copy"><span class="pulse-orbit">CP</span><div><span class="eyebrow">REPEATED ISSUE MONITORING</span><h2>Campus Pulse</h2><p>Helps facilities teams spot recurring issues. A hotspot appears when at least two Open or In Progress requests share the same building and category. Resolved requests do not count.</p></div></div>
    <% if (hotspots.length) { %>
      <div class="pulse-hotspots">
        <% hotspots.forEach((spot) => { %>
          <a class="hotspot-card" href="/dashboard?q=<%= encodeURIComponent(spot.building) %>">
            <span class="hotspot-signal"><%= spot.priority_score >= 4 ? '●' : '↗' %></span>
            <span class="hotspot-main"><strong><%= spot.building %></strong><small><%= spot.category %> · <%= spot.reports %> open reports</small></span>
            <span class="hotspot-arrow" aria-hidden="true">→</span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="pulse-empty"><span>✦</span><div><strong>No repeated unresolved issues</strong><small>Submit two Open or In Progress reports for the same building and maintenance category to surface a hotspot.</small></div></div>
    <% } %>
  </section>

  <section class="sla-panel" aria-label="Priority service target summary">
    <div class="sla-copy"><span class="sla-icon">SLA</span><div><span class="eyebrow">PRIORITY RESPONSE MONITORING</span><h2>Campus SLA Watch</h2><p>Open requests are tracked against response targets based on their priority.</p></div></div>
    <div class="sla-metrics">
      <div class="sla-metric <%= slaStats.overdue ? 'sla-metric-overdue' : '' %>"><strong><%= slaStats.overdue %></strong><span>Overdue</span></div>
      <div class="sla-metric"><strong><%= slaStats.due_soon %></strong><span>Due within 24 hours</span></div>
      <small>Urgent 24h · High 72h · Normal 7 days · Low 14 days</small>
    </div>
  </section>

  <section class="requests-section">
    <div class="section-heading"><div><span class="eyebrow">THE DETAILS</span><h2><%= technicianView ? 'Requests for your specialties' : staffView ? 'Campus requests' : 'Your campus requests' %></h2></div><span class="result-count"><%= requests.length %><%= requests.length === 100 ? '+' : '' %> shown</span></div>
    <form action="/dashboard" method="GET" class="filter-bar">
      <div class="search-wrap"><span aria-hidden="true">⌕</span><input type="search" name="q" value="<%= search %>" placeholder="Search location, category or title…" aria-label="Search requests"></div>
      <select name="status" class="form-select filter-select" aria-label="Filter by status">
        <option value="">All statuses</option>
        <% ['Open', 'In Progress', 'Resolved'].forEach((item) => { %><option value="<%= item %>" <%= status === item ? 'selected' : '' %>><%= item %></option><% }) %>
      </select>
      <button class="btn btn-filter" type="submit">Filter</button>
      <% if (search || status) { %><a class="clear-filter" href="/dashboard">Clear</a><% } %>
    </form>
    <% if (requests.length) { %>
      <div class="request-list">
        <% requests.forEach((request) => { %>
          <a class="request-row <%= request.priority === 'Urgent' ? 'request-row-urgent' : '' %>" href="/requests/<%= request.id %>">
            <div class="request-category-icon icon-<%= request.category.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= ({Electrical:'ϟ',Plumbing:'≈','Heating & Cooling':'☼',Cleaning:'✧',Furniture:'▱',Safety:'＋',Technology:'⌘',Other:'✳'})[request.category] %></div>
            <div class="request-row-main"><div class="request-title-line"><strong><%= request.title %></strong><span class="priority priority-<%= request.priority.toLowerCase() %>"><span></span><%= request.priority %></span></div><div class="request-meta"><span><%= request.building %><%= request.room ? ` · ${request.room}` : '' %></span><span class="meta-divider">·</span><span><%= request.category %></span><% if (staffView) { %><span class="meta-divider">·</span><span>By <%= request.reporter_name %></span><% } %><% if (request.status !== 'Resolved') { %><span class="sla-request-label <%= request.is_overdue ? 'is-overdue' : request.due_soon ? 'is-due-soon' : '' %>"><%= request.is_overdue ? 'Past target' : request.due_soon ? 'Due within 24h' : 'Target ' + new Date(`${request.due_at.replace(' ', 'T')}Z`).toLocaleDateString() %></span><% } %><% if (requestCta && request.status === 'Resolved') { %><span class="review-prompt <%= request.feedback_rating ? 'review-complete' : '' %>"><%= request.feedback_rating ? `Technician review · ${request.feedback_rating}/5` : 'Review technician in request details' %></span><% } %></div></div>
            <div class="request-row-side"><span class="status-pill status-<%= request.status.toLowerCase().replace(' ', '-') %>"><%= request.status %></span><% if (request.priority === 'Urgent') { %><span class="priority-urgent-label">Urgent priority</span><% } %><% if (technicianView && Number(request.assigned_to) === Number(user.id)) { %><span class="assignment-label">Accepted by you</span><% } %><small><%= new Date(`${request.created_at.replace(' ', 'T')}Z`).toLocaleDateString() %></small></div>
            <span class="row-chevron" aria-hidden="true">›</span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state"><span class="empty-illustration">⌂</span><h3><%= search || status ? 'No matching requests' : technicianView ? 'No matching requests yet' : 'Nothing needs fixing. Yet.' %></h3><p><%= search || status ? 'Try a different search or clear your filters.' : technicianView ? 'Open requests in your specialties will appear here. Manage your specialties from your profile.' : staffView ? 'New campus requests will show up here.' : 'When something around campus needs attention, this is where your request will live.' %></p><% if (!search && !status && requestCta) { %><a class="btn btn-primary" href="/requests/new">Submit a campus request</a><% } else if (technicianView && !requests.length) { %><a class="btn btn-primary" href="/profile">Review your specialties</a><% } %></div>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
