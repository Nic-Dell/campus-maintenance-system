<%- include('partials/header') %>
<main class="page-wrap narrow-page">
  <a href="/dashboard" class="back-link">← <span>Back to dashboard</span></a>
  <% if (notice) { %><div class="alert alert-<%= notice.type %>"><%= notice.message %></div><% } %>
  <section class="detail-card">
    <div class="detail-topline"><span class="eyebrow">REQUEST #<%= String(request.id).padStart(4, '0') %></span><span class="status-pill status-<%= request.status.toLowerCase().replace(' ', '-') %>"><%= request.status %></span></div>
    <h1><%= request.title %></h1>
    <div class="detail-tags"><span><%= request.category %></span><span class="priority-detail priority-<%= request.priority.toLowerCase() %>"><%= request.priority %> priority</span><% if (request.status !== 'Resolved' && request.due_at) { %><span class="<%= new Date(`${request.due_at.replace(' ', 'T')}Z`).getTime() <= Date.now() ? 'sla-detail-overdue' : '' %>">Target <%= new Date(`${request.due_at.replace(' ', 'T')}Z`).toLocaleString() %></span><% } %></div>
    <p class="detail-description"><%= request.description %></p>
    <div class="detail-facts"><div><span>LOCATION</span><strong><%= request.building %><%= request.room ? ` · ${request.room}` : '' %></strong></div><div><span>REPORTED BY</span><strong><%= request.reporter_name %></strong></div><div><span>SUBMITTED</span><strong><%= new Date(`${request.created_at.replace(' ', 'T')}Z`).toLocaleString() %></strong></div><% if (request.assignee_name) { %><div><span>SCHEDULED TECHNICIAN</span><strong><%= request.assignee_name %></strong></div><% } %></div>
    <div class="scheduling-notice"><strong>Priority-based technician scheduling</strong><p>UniFix assigns requests to an administrator-verified technician qualified for this category, choosing the technician with the fewest active requests. Urgent and high-priority requests are shown first in the technician queue. If no qualified technician is available, the request remains unassigned for an eligible technician to claim.</p></div>
    <% if (request.report_image || request.before_image || request.after_image) { %>
      <section class="evidence-section" aria-label="Request photographs">
        <h2>Photographic evidence</h2>
        <div class="evidence-grid">
          <% if (request.report_image) { %><figure><img src="/requests/<%= request.id %>/images/report" alt="Area photo submitted with the issue report"><figcaption>Reported area</figcaption></figure><% } %>
          <% if (request.before_image) { %><figure><img src="/requests/<%= request.id %>/images/before" alt="Area photo before maintenance work"><figcaption>Before maintenance</figcaption></figure><% } %>
          <% if (request.after_image) { %><figure><img src="/requests/<%= request.id %>/images/after" alt="Area photo after maintenance work"><figcaption>After maintenance</figcaption></figure><% } %>
        </div>
      </section>
    <% } %>
    <% if (canClaim) { %><form action="/requests/<%= request.id %>/accept" method="POST" class="accept-request-panel"><div><span class="eyebrow">MATCHES YOUR SPECIALTIES</span><strong>Accept this campus request</strong><p>Once accepted, it will be assigned to you and you can update its work status.</p></div><button type="submit" class="btn btn-primary">Accept request</button></form><% } %>
    <% if (staffView && (user.role === 'admin' || user.role === 'staff' && Number(request.assigned_to) === Number(user.id))) { %>
      <form action="/requests/<%= request.id %>/status" method="POST" class="staff-update" enctype="multipart/form-data" id="staff-update-form">
        <div><span class="eyebrow"><%= user.role === 'admin' ? 'CAMPUS OPERATIONS' : 'TECHNICAL TEAM WORKSPACE' %></span><h2>Update this request</h2><p>Attach a before-work photo when work begins and an after-work photo before resolving the request.</p></div>
        <label class="field-label" for="status">Status</label>
        <select id="status" name="status" class="form-select" data-current-status="<%= request.status %>" data-has-before="<%= request.before_image ? 'true' : 'false' %>" data-has-after="<%= request.after_image ? 'true' : 'false' %>"><% statuses.forEach((status) => { %><option value="<%= status %>" <%= request.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select>
        <label class="field-label mt-3" for="note">Update note <span class="optional-label" id="note-guidance">Required for status changes · optional for evidence-only updates</span></label>
        <input id="note" name="note" type="text" class="form-control" maxlength="240" placeholder="Explain the status change for the reporter" aria-describedby="note-guidance">
        <label class="field-label mt-3" for="before_image">Before-work photo <span class="optional-label">Required when work begins · max 5 MB</span></label>
        <input id="before_image" name="before_image" type="file" class="form-control image-upload" accept="image/jpeg,image/png,image/webp">
        <label class="field-label mt-3" for="after_image">After-work photo <span class="optional-label">Required before resolution · max 5 MB</span></label>
        <input id="after_image" name="after_image" type="file" class="form-control image-upload" accept="image/jpeg,image/png,image/webp">
        <button type="submit" class="btn btn-primary mt-3">Save update</button>
      </form>
    <% } %>
    <% if (request.feedback_rating) { %>
      <section class="review-summary" aria-labelledby="review-summary-title">
        <div class="review-summary-heading"><div><span class="eyebrow">REPORTER REVIEW</span><h2 id="review-summary-title">Review for <%= request.assignee_name || 'the maintenance team' %></h2></div><span class="review-score"><strong><%= request.feedback_rating %></strong><span>out of 5</span></span></div>
        <% if (request.feedback_comment) { %><blockquote><%= request.feedback_comment %></blockquote><% } else { %><p class="review-no-comment">No written comment was provided.</p><% } %>
        <small>Last updated <%= new Date(`${request.feedback_updated_at.replace(' ', 'T')}Z`).toLocaleString() %></small>
      </section>
    <% } %>
    <% if (canGiveFeedback) { %>
      <form action="/requests/<%= request.id %>/feedback" method="POST" class="feedback-panel">
        <span class="eyebrow">RATE YOUR TECHNICIAN</span>
        <h2><%= request.feedback_rating ? 'Update your technician review' : 'How did your technician do?' %></h2>
        <p>Your review is shared with <%= request.assignee_name || 'the maintenance team' %> and campus administration.</p>
        <fieldset class="star-rating-fieldset">
          <legend class="field-label">Select a star rating</legend>
          <div class="star-rating" role="radiogroup" aria-label="Rate the technician from 1 to 5 stars">
            <% [5, 4, 3, 2, 1].forEach((rating) => { %><input id="rating-<%= rating %>" type="radio" name="rating" value="<%= rating %>" aria-label="<%= rating %> stars" <%= Number(request.feedback_rating) === rating ? 'checked' : '' %> required><label for="rating-<%= rating %>" title="<%= rating %> stars">★</label><% }) %>
          </div>
        </fieldset>
        <label class="field-label mt-3" for="feedback-comment">Message to the technician</label>
        <textarea id="feedback-comment" name="comment" class="form-control" minlength="5" maxlength="1000" rows="3" placeholder="Tell the technician about your experience (5 to 1,000 characters)" required><%= request.feedback_comment || '' %></textarea>
        <button type="submit" class="btn btn-primary mt-3"><%= request.feedback_rating ? 'Update review' : 'Submit review' %></button>
      </form>
    <% } %>
    <div class="timeline-heading"><div><span class="eyebrow">KEEPING YOU IN THE LOOP</span><h2>Request timeline</h2></div></div>
    <ol class="timeline">
      <% updates.forEach((update) => { %><li><span class="timeline-marker"></span><div><strong><%= update.status %></strong><p><%= update.note %></p><small><%= update.actor_name %> · <%= new Date(`${update.created_at.replace(' ', 'T')}Z`).toLocaleString() %></small></div></li><% }) %>
    </ol>
    <% if (!staffView && request.status === 'Open') { %><form action="/requests/<%= request.id %>/delete" method="POST" class="withdraw-form" onsubmit="return confirm('Withdraw this open request?')"><button type="submit" class="btn btn-quiet danger-quiet">Withdraw this request</button></form><% } %>
  </section>
</main>
<% if (staffView) { %>
<script>
  const statusField = document.getElementById('status');
  const noteField = document.getElementById('note');
  const beforePhoto = document.getElementById('before_image');
  const afterPhoto = document.getElementById('after_image');
  const updateNoteRequirement = () => {
    noteField.required = statusField.value !== statusField.dataset.currentStatus;
  };
  const updatePhotoRequirements = () => {
    beforePhoto.required = ['In Progress', 'Resolved'].includes(statusField.value) && statusField.dataset.hasBefore !== 'true';
    afterPhoto.required = statusField.value === 'Resolved' && statusField.dataset.hasAfter !== 'true';
  };
  statusField.addEventListener('change', updateNoteRequirement);
  statusField.addEventListener('change', updatePhotoRequirements);
  updateNoteRequirement();
  updatePhotoRequirements();
</script>
<% } %>
<%- include('partials/footer') %>
