PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
# UniFix uses XAMPP MySQL/MariaDB by default. The database is created on first start.
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campus_maintenance
# Path of the existing SQLite file to import once into the MySQL database.
SQLITE_IMPORT_PATH=data\campus-maintenance.sqlite
# Optional: absolute path to keep private uploaded images outside the project directory.
# UPLOADS_PATH=C:\campus-data\campus-maintenance-uploads
# Optional: create the first admin account once, when the database is empty.
# ADMIN_NAME=Campus Administrator
# ADMIN_EMAIL=admin@campus.edu
# ADMIN_UNIQUE_ID=12345678
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters